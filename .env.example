# Golden Trade X — Environment Configuration Template
# Copy to .env and fill in your values. Never commit .env to version control.
#
# Install python-dotenv to auto-load: pip install python-dotenv
#
# SEGURIDAD: configura el token SIEMPRE aquí (o como variable de entorno),
# nunca como argumento de línea de comandos — los argumentos CLI quedan en el
# historial de la shell y son visibles en la lista de procesos del sistema.

# ── Telegram Alerts (live_monitor.py Y monitor.py) ────────────────────────────
# Create a bot: https://t.me/BotFather → /newbot → copy the token
# Get your chat ID: send /start to @userinfobot on Telegram
# v2.61: AMBOS monitores leen estas variables (monitor.py también acepta las
# legacy GTX_TG_TOKEN/GTX_TG_CHAT_ID, pero estas son las canónicas).
GTX_TELEGRAM_TOKEN=
GTX_TELEGRAM_CHAT_ID=

# ── Live Monitor Settings (live_monitor.py) ───────────────────────────────────
GTX_DAILY_DD_ALERT_PCT=3.0    # Send alert when daily drawdown reaches this %
GTX_CONSEC_LOSS_ALERT=2       # Send alert after N consecutive losses
GTX_POLL_INTERVAL=10          # Seconds between CSV file checks
GTX_MAGIC_NUMBER=920260       # Must match InpMagicNumber in GoldenTradeX.mq5

# Directorio donde el EA escribe los CSV (TradeLogger + status de HealthMonitor).
# v2.51+: AMBOS se escriben en la carpeta COMÚN del terminal (FILE_COMMON):
#   Windows: C:\Users\<TU_USUARIO>\AppData\Roaming\MetaQuotes\Terminal\Common\Files
# Apunta esta variable a esa carpeta (el default "." solo sirve si ejecutas
# los scripts DESDE esa carpeta).
GTX_TRADE_CSV_DIR=.

# ── monitor.py (monitor de cuenta via API MetaTrader5) ────────────────────────
GTX_SYMBOL=XAUUSD             # Símbolo del broker (XAUUSD, GOLD, XAUUSD.m, ...)
GTX_MAGIC=920260              # Magic number del EA
GTX_ALERT_DD_PCT=2.0          # Caída de equity % que dispara alerta

# ── Correlation Engine / Data (scripts/correlation_engine.py) ─────────────────
# No API keys needed — uses yfinance (public data)
