# Golden Trade X — Environment Configuration Template
# Copy to .env and fill in your values. Never commit .env to version control.
#
# Install python-dotenv to auto-load: pip install python-dotenv

# ── Telegram Alerts (scripts/live_monitor.py) ─────────────────────────────────
# Create a bot: https://t.me/BotFather → /newbot → copy the token
GTX_TELEGRAM_TOKEN=
# Get your chat ID: send /start to @userinfobot on Telegram
GTX_TELEGRAM_CHAT_ID=

# ── Live Monitor Settings ──────────────────────────────────────────────────────
GTX_DAILY_DD_ALERT_PCT=3.0    # Send alert when daily drawdown reaches this %
GTX_CONSEC_LOSS_ALERT=2       # Send alert after N consecutive losses
GTX_TRADE_CSV_DIR=.           # Directory where GoldenTradeX_*.csv files are saved
GTX_POLL_INTERVAL=10          # Seconds between CSV file checks
GTX_MAGIC_NUMBER=920260       # Must match InpMagicNumber in GoldenTradeX.mq5

# ── Correlation Engine / Data (scripts/correlation_engine.py) ─────────────────
# No API keys needed — uses yfinance (public data)
