    ],
    "tie_breakers": [
      {
        "metric": "expected_payoff",
        "direction": "maximize"
      },
      {
        "metric": "total_net_profit",
        "direction": "maximize"
      }
    ]
  },
  "promotion_policy_path": "promotion_policy.v1.json"
}
