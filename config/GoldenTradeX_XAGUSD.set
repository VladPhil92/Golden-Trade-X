; Golden Trade X v2.61 — preset XAGUSD (Plata) M15
; Arrastrar el EA al gráfico XAGUSD M15 con este preset.
; Magic number diferente (920261) para operar en paralelo con la instancia XAUUSD.
;
; Diferencias clave vs XAUUSD:
;   - InpMagicNumber  : 920261  (evita colisiones de GlobalVariables)
;   - InpMaxSpreadPoints: 500   (spreads de plata son más amplios: 120-400 pts)
;   - El cálculo de lote usa ATR del símbolo, por lo que se adapta
;     automáticamente a la mayor volatilidad de la plata.
;   - Ajuste fino de RSI y ATR recomendado tras backtest en XAGUSD.

InpMagicNumber=920261
InpTradeComment=GoldenTradeX_XAGUSD

; --- Senales ---
InpEmaFast=21
InpEmaSlow=55
InpRsiPeriod=14
InpRsiUpper=70.0
InpRsiLower=30.0
InpRsiLongMin=45.0
InpRsiShortMax=55.0
InpTimeframe=15
InpAtrPeriod=14
InpAtrMinRatio=0.8
InpAtrMaxRatio=3.0
InpAdxPeriod=14
InpAdxMinLevel=25.0

; --- Filtro HTF ---
InpUseHtfFilter=true
InpHtfEmaPeriod=50

; --- Confluence Score & Smart Money (heuristico, v2.00) ---
InpUseRegimeFilter=true
InpUseSmcFilter=true
InpMinConfidence=55
InpConfWeightBase=25
InpConfWeightRegime=25
InpConfWeightSmc=30
InpConfWeightHtf=15
InpConfWeightFib=5

; --- Riesgo ---
InpRiskPercent=1.0
InpMaxDailyDD=4.0
InpMaxWeeklyDD=8.0
InpMaxMonthlyDD=15.0
InpMaxConsecLosses=3
InpMaxPositions=1
InpAtrSlMultiplier=2.0
InpAtrTpMultiplier=3.0
InpMaxSpreadPoints=500
InpCpThresholdPct=8.0

; --- Trailing y Break-Even ---
InpUseTrailing=true
InpTrailAtrMult=1.5
InpUseBreakEven=true
InpBreakEvenR=0.5

; --- Sesiones ---
InpUseSessionFilter=true
InpStartHour=7
InpEndHour=20
InpCloseOnFriday=true
InpFridayCloseHour=19

; --- Noticias ---
InpUseNewsFilter=true
InpNewsBufferBefore=30
InpNewsBufferAfter=90
InpPauseForNews=false

; --- Kelly Criterion Fraccional (v2.40) ---
; InpUseKelly=false por defecto. Activar solo tras >= InpKellyMinTrades en historial.
InpUseKelly=false
InpKellyFraction=0.25
InpKellyMinTrades=30

; --- Order Manager (v2.30) ---
InpOrderMaxRetries=3
InpOrderRetryDelay=500
InpMinMarginLevel=200.0

; --- Portfolio Risk Cap (v2.60) ---
; Si corres esta instancia (XAGUSD) EN PARALELO con GoldenTradeX.set (XAUUSD),
; activa InpUsePortfolioCap=true en AMBAS instancias con el MISMO
; InpMaxPortfolioRiskPct — comparten el mismo presupuesto por cuenta.
InpUsePortfolioCap=false
InpMaxPortfolioRiskPct=1.5

; --- Partial Take Profit (v2.20) ---
InpUsePartialTP=true
InpPartialTPR=1.0
InpPartialTPPct=50.0

; --- Equity Curve Filter (v2.20) ---
InpUseEqCurveFilter=true
InpEqCurvePeriod=20

; --- Filtro volumen de ticks (v2.20) ---
InpMinTickVolume=10

; --- Registro ---
InpEnableTradeLog=true
