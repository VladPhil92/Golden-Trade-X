; Golden Trade X v2.60 — preset por defecto (XAUUSD M15)
; Nota DST: StartHour/EndHour estan en hora del servidor del broker.
; La mayoria de brokers usa EET (GMT+2 verano / GMT+3 invierno).

InpMagicNumber=920260
InpTradeComment=GoldenTradeX

; --- Senales ---
InpEmaFast=21
InpEmaSlow=55
InpRsiPeriod=14
InpRsiUpper=70.0
InpRsiLower=30.0
InpRsiLongMin=45.0
InpRsiShortMax=55.0
InpTimeframe=15
InpAtrPeriod=14
InpAtrMinRatio=0.8
InpAtrMaxRatio=3.0
InpAdxMinLevel=25.0

; --- Filtro HTF ---
InpUseHtfFilter=true
InpHtfEmaPeriod=50

; --- Confluence Score & Smart Money (heuristico, v2.00) ---
InpUseRegimeFilter=true
InpUseSmcFilter=true
InpMinConfidence=55
; Pesos del Confluence Score (v2.60) — heuristicos, no calibrados con datos.
; Configurables para optimizar via Strategy Tester una vez haya historial real.
InpConfWeightBase=25
InpConfWeightRegime=25
InpConfWeightSmc=30
InpConfWeightHtf=15
InpConfWeightFib=5

; --- Riesgo ---
InpRiskPercent=1.0
InpMaxDailyDD=4.0
InpMaxWeeklyDD=8.0
InpMaxMonthlyDD=15.0
InpMaxConsecLosses=3
InpMaxPositions=1
InpAtrSlMultiplier=2.0
InpAtrTpMultiplier=3.0
InpMaxSpreadPoints=350
InpCpThresholdPct=8.0

; --- Trailing y Break-Even ---
InpUseTrailing=true
InpTrailAtrMult=1.5
InpUseBreakEven=true
InpBreakEvenR=0.5

; --- Sesiones ---
InpUseSessionFilter=true
InpStartHour=7
InpEndHour=20
InpCloseOnFriday=true
InpFridayCloseHour=19

; --- Noticias ---
InpUseNewsFilter=true
InpNewsBufferBefore=30
InpNewsBufferAfter=90
InpPauseForNews=false

; --- Kelly Criterion Fraccional (v2.40) ---
; InpUseKelly=false por defecto. Activar solo tras >= InpKellyMinTrades en historial.
InpUseKelly=false
InpKellyFraction=0.25
InpKellyMinTrades=30

; --- Order Manager (v2.30) ---
InpOrderMaxRetries=3
InpOrderRetryDelay=500
InpMinMarginLevel=200.0

; --- Portfolio Risk Cap (v2.60) ---
; Riesgo agregado maximo entre TODAS las instancias del EA en esta cuenta
; (p.ej. XAUUSD + XAGUSD corriendo en paralelo). OFF por defecto para no
; alterar el comportamiento de instalaciones existentes de un solo simbolo.
; Si corres varios simbolos a la vez, activa esto en TODAS las instancias
; con el MISMO InpMaxPortfolioRiskPct — comparten presupuesto por cuenta.
InpUsePortfolioCap=false
InpMaxPortfolioRiskPct=1.5

; --- Partial Take Profit (v2.20) ---
InpUsePartialTP=true
InpPartialTPR=1.0
InpPartialTPPct=50.0

; --- Equity Curve Filter (v2.20) ---
InpUseEqCurveFilter=true
InpEqCurvePeriod=20

; --- Filtro volumen de ticks (v2.20) ---
InpMinTickVolume=10

; --- Registro ---
InpEnableTradeLog=true
