; Golden Trade X v2.62 — preset por defecto (XAUUSD M15)
; Nota DST: StartHour/EndHour aun estan en hora del servidor del broker.

InpMagicNumber=920260
InpTradeComment=GoldenTradeX
InpAllowRealTrading=false

; --- Senales ---
InpEmaFast=21
InpEmaSlow=55
InpRsiPeriod=14
InpRsiUpper=70.0
InpRsiLower=30.0
InpRsiLongMin=45.0
InpRsiShortMax=55.0
InpTimeframe=15
InpAtrPeriod=14
InpAtrMinRatio=0.8
InpAtrMaxRatio=3.0
InpAdxPeriod=14
InpAdxMinLevel=25.0

; --- Filtro HTF ---
InpUseHtfFilter=true
InpHtfEmaPeriod=50

; --- Confluence Score & Smart Money (heuristico, no calibrado) ---
InpUseRegimeFilter=true
InpUseSmcFilter=true
InpMinConfidence=55
InpConfWeightBase=25
InpConfWeightRegime=25
InpConfWeightSmc=30
InpConfWeightHtf=15
InpConfWeightFib=5

; --- Riesgo ---
InpRiskPercent=1.0
InpMaxDailyDD=4.0
InpMaxWeeklyDD=8.0
InpMaxMonthlyDD=15.0
InpMaxConsecLosses=3
InpMaxPositions=1
InpAtrSlMultiplier=2.0
InpAtrTpMultiplier=3.0
InpMaxSpreadPoints=350
InpCpThresholdPct=8.0
; 0.0 = guard RR desactivado hasta disponer de evidencia OOS para fijar umbral.
InpMinInitialRR=0.0

; --- Trailing y Break-Even ---
InpUseTrailing=true
InpTrailAtrMult=1.5
InpUseBreakEven=true
InpBreakEvenR=0.5

; --- Sesiones ---
InpUseSessionFilter=true
InpStartHour=7
InpEndHour=20
InpCloseOnFriday=true
InpFridayCloseHour=19

; --- Noticias ---
InpUseNewsFilter=true
InpNewsBufferBefore=30
InpNewsBufferAfter=90
; 0=WARN, 1=FAIL_CLOSED, 2=FAIL_OPEN. WARN preserva backtests historicos
; mientras se construye el calendar cache oficial; produccion debera evaluar 1.
InpNewsCalendarPolicy=0
InpPauseForNews=false

; --- Kelly Criterion Fraccional ---
InpUseKelly=false
InpKellyFraction=0.25
InpKellyMinTrades=30

; --- Order Manager ---
InpOrderMaxRetries=3
InpOrderRetryDelay=500
InpMinMarginLevel=200.0

; --- Portfolio Risk Cap ---
InpUsePortfolioCap=false
InpMaxPortfolioRiskPct=1.5

; --- Partial Take Profit ---
InpUsePartialTP=true
InpPartialTPR=1.0
InpPartialTPPct=50.0

; --- Equity Curve Filter ---
InpUseEqCurveFilter=true
InpEqCurvePeriod=20

; --- Filtro volumen de ticks ---
InpMinTickVolume=10

; --- Registro ---
InpEnableTradeLog=true
